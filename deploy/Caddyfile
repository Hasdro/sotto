# HTTPS for Sotto (D-020). SOTTO_DOMAIN comes from /etc/sotto/sotto.env, e.g. 104-168-48-116.sslip.io
# (works without buying a domain) or sotto.yourcompany.com (point its DNS A record here first).
{$SOTTO_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "microphone=(self), camera=()"
		-Server
	}
	reverse_proxy sotto:8787
}
