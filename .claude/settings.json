{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)"
    ],
    "allow": [
      "Bash(bash scripts/doctor.sh)",
      "Bash(scripts/doctor.sh)",
      "Bash(git status *)",
      "Bash(git fetch *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(pnpm test *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm replay *)",
      "Bash(uv run pytest *)",
      "Bash(supabase test db)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm format)",
      "Bash(pnpm gen)",
      "Bash(bash scripts/check-boundaries.sh)",
      "Bash(bash scripts/tests/run.sh)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f docs/TRACKER.md ] && { echo 'Sotto tracker \u2014 current state (run /next-task to start):'; sed -n '/^## Now/,/^## Phase board/p' docs/TRACKER.md | grep -v -e '^## Phase board' -e '<!--'; }; exit 0"
          },
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = true ] && [ -f package.json ] && command -v pnpm >/dev/null && pnpm install --frozen-lockfile >/dev/null 2>&1; [ \"$CLAUDE_CODE_REMOTE\" = true ] && [ -f apps/agent-worker/uv.lock ] && command -v uv >/dev/null && (cd apps/agent-worker && uv sync --frozen >/dev/null 2>&1); exit 0"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f package.json ] && pnpm -s format >/dev/null 2>&1; exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f package.json ] || exit 0; pnpm -s typecheck && pnpm -s test || exit 2"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  }
}
