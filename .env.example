# Sotto environment variables: names only, never values.
# Copy to .env (git-ignored) and fill in what you need. Every variable is optional for the local demo.
# What each one does: docs/ENV.md. Platform keys are only ever sent to their own provider's host (D-016).

# Free AI (D-016, D-017)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Paid AI, only if a route uses these providers (none does by default)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Speech-to-text (P2.3 pick-list, then the chosen primary and backup in Phase 4)
DEEPGRAM_API_KEY=
SPEECHMATICS_API_KEY=
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=

# Escalation emails (Phase 7)
RESEND_API_KEY=

# Live calls (Phase 4)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Database and sign-in (Phase 5)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# App, demo bridge
EXPO_PUBLIC_DEMO_BRIDGE_URL=
EXPO_PUBLIC_SOTTO_DEMO=
# D-022: the management server the apps sign in to (set by deploy/push.sh, apps/desktop, apps/extension)
EXPO_PUBLIC_SOTTO_SERVER=

# Replay: golden-call audio folder outside git
SOTTO_RECORDINGS_DIR=

# Sotto server (D-020). Local `pnpm demo` needs none of these; the hosted server keeps them in
# /etc/sotto/sotto.env (deploy/install.sh writes it).
SOTTO_ACCESS_CODE=
SOTTO_SECRET_KEY=
SOTTO_PUBLIC_ORIGIN=
SOTTO_DATA_DIR=
SOTTO_TRUSTED_PROXY=
SOTTO_DOMAIN=

# Zoho Web Application Client
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=